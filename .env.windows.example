# Salad Monitor - Windows Docker Desktop Configuration
# Copy this file to .env.windows and customize as needed

# ============================================================================
# Core Configuration
# ============================================================================

# Directory where logs are stored inside container
LOG_DIR=/logs

# Enable debug logging (true/false)
DEBUG=false

# ============================================================================
# Feature Flags
# ============================================================================

# Enable hardware monitoring (CPU, RAM, GPU, Disk)
ENABLE_HARDWARE_MONITORING=true

# Enable GPU Demand API polling
ENABLE_GPU_DEMAND_API=true

# Enable network monitoring
ENABLE_NETWORK_MONITORING=true

# Enable process monitoring
ENABLE_PROCESS_MONITORING=true

# ============================================================================
# GPU Configuration
# ============================================================================

# GPU demand API cache duration in minutes
GPU_DEMAND_CACHE_MINUTES=5

# NVIDIA Container Toolkit settings (if using NVIDIA GPU)
# Which GPUs to make visible to container (all, 0, 1, etc.)
NVIDIA_VISIBLE_DEVICES=all

# GPU capabilities needed
# Options: compute, graphics, utility (comma-separated)
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================================
# Development vs Production
# ============================================================================

# Uncomment for development with verbose logging
# DEBUG=true
# ENABLE_HARDWARE_MONITORING=true

# Uncomment for production (minimal logging)
# DEBUG=false
# ENABLE_HARDWARE_MONITORING=true
